#!/usr/bin/python3
import requests
import meshtastic
import meshtastic.tcp_interface
import sys
import logging
import time
import os
import errno
import argparse

# Target Production Endpoint
OPENWEATHERMAP_URL = "https://api.openweathermap.org/data/2.5/weather"

# --- LOGGING SETUP ---
logging.basicConfig(
    filename='/scripts/logs/mesh_weather.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    datefmt='%Y-%m-%d %H:%M:%S'
)

LOCK_DIR = "/scripts/logs/mesh_weather_loc"

def acquire_lock():
    try:
        os.makedirs(LOCK_DIR)
        return True
    except OSError as e:
        if e.errno == errno.EEXIST:
            logging.warning("Another instance of the script is already running.")
            return False
        else:
            raise

def release_lock():
    try:
        os.rmdir(LOCK_DIR)
    except OSError as e:
        if e.errno != errno.ENOENT:
            logging.error(f"Failed to remove lock directory: {e}")

def get_weather_data(city, api_key):
    parameters = {"q": city, "appid": api_key, "units": "imperial"}
    attempts = 3
    delay = 10  # Delay in seconds between retries

    for attempt in range(1, attempts + 1):
        try:
            logging.info(f"Fetching weather data (Attempt {attempt}/{attempts})...")
            response = requests.get(OPENWEATHERMAP_URL, params=parameters, timeout=7)
            response.raise_for_status()

            try:
                # Attempt to parse payload as authentic JSON
                data = response.json()
                logging.info(f"Received weather response with status code {response.status_code}")
                return data
            except requests.exceptions.JSONDecodeError:
                # Caught local gateway/interception landing page html data
                truncated_response = response.text[:100].replace('\n', ' ')
                logging.warning(f"Attempt {attempt}: API traffic intercepted by local network. Raw start: {truncated_response}")

                if attempt < attempts:
                    logging.info(f"Waiting {delay} seconds for local DNS/network gateway to settle before retry...")
                    time.sleep(delay)
                    continue
                else:
                    logging.error("API connection failed repeatedly due to network routing interception.")
                    return None

        except requests.exceptions.RequestException as e:
            logging.error(f"Outbound network gateway connection failed on attempt {attempt}: {e}")
            if attempt < attempts:
                logging.info(f"Waiting {delay} seconds before retry...")
                time.sleep(delay)
                continue
            return None
    return None

def format_weather_message(weather_data, city_name):
    try:
        # Secure structure parsing for array objects inside dictionary keys
        description = weather_data['weather'][0]['description']
        main_data = weather_data['main']
        temp = main_data['temp']
        feels_like = main_data['feels_like']
        humidity = main_data['humidity']
        pressure = main_data['pressure']
        wind_speed = weather_data['wind']['speed']
        wind_direction = weather_data['wind']['deg']

        def get_cardinal_direction(degrees):
            # FIXED: Expanded to high-precision 16-point tracking using 22.5-degree divisor
            directions = [
                "⬆️N", "↗️NNE", "↗️NE", "↗️ENE", 
                "➡️E", "↘️ESE", "↘️SE", "↘️SSE", 
                "⬇️S", "↙️SSW", "↙️SW", "↙️WSW", 
                "⬅️W", "↖️WNW", "↖️NW", "↖️NNW"
            ]
            index = int((degrees / 22.5) + 0.5)
            return directions[index % 16]

        wind_direction_text = get_cardinal_direction(wind_direction)

        weather_message = (
            f"🌦️ {city_name}:\n"
            f"ⓘ {description.capitalize()}, feels like {feels_like}°F\n"
            f"🌡️ {temp}°F\n"
            f"💧 {humidity}%\n"
            f"🗜️ {pressure}hPa\n"
            f"💨 {wind_speed}mph {wind_direction_text}"
        )

        safe_message = weather_message[:200]
        logging.info(f"Formatted payload length: {len(safe_message)} characters.")
        return safe_message

    except (KeyError, IndexError) as e:
        logging.error(f"Error parsing weather JSON structure: {e}")
        return None

def main():
    parser = argparse.ArgumentParser(description="Send localized OpenWeatherMap data to a Meshtastic Node.")
    parser.add_argument("--node", type=str, default="192.168.50.49", help="IP address of the Meshtastic Node")
    parser.add_argument("--api_key", type=str, default="657a00d5432de53b195e03853240e2e9", help="OpenWeatherMap API Key")
    parser.add_argument("--channel", type=int, default=5, help="Meshtastic channel index to broadcast on")
    parser.add_argument("--city", type=str, default="Tampa", help="Target city for weather tracking")
    args = parser.parse_args()

    if not acquire_lock():
        logging.info("Exiting because another instance of the script is already running.")
        return

    try:
        logging.info("Lock acquired, starting scheduled weather task...")

        weather_data = get_weather_data(args.city, args.api_key)
        if not weather_data:
            logging.warning("Skipping task: Weather data unavailable.")
            return

        formatted_message = format_weather_message(weather_data, args.city)
        if not formatted_message:
            logging.warning("Skipping task: Message formatting failed.")
            return

        interface = None
        try:
            logging.info(f"Connecting to Meshtastic node at {args.node}...")
            interface = meshtastic.tcp_interface.TCPInterface(hostname=args.node)
            logging.info("Connected successfully!")

            logging.info("Stabilizing hardware interface before transmission...")
            time.sleep(3)

            logging.info("Sending message to Mesh...")
            interface.sendText(text=formatted_message, channelIndex=args.channel)

            logging.info("Waiting 5 seconds for radio transmission buffer to clear...")
            time.sleep(5)
            logging.info("Sent weather message successfully.")

        except meshtastic.exceptions.MeshtasticError as e:
            logging.error(f"Meshtastic hardware interface error: {e}")
        except Exception as e:
            logging.error(f"Unexpected error occurred: {e}")
        finally:
            if interface:
                logging.info("Closing connection to node...")
                interface.close()

        logging.info("Task completed successfully.\n" + "-"*40)

    finally:
        release_lock()

if __name__ == "__main__":
    main()
